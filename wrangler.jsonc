{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ccs-assist",
	"pages_build_output_dir": ".svelte-kit/cloudflare",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-09-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	}
}
